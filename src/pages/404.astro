---
import Base from '../layouts/Base.astro';
---

<Base title="Stránka nenalezena">
  <section class="nf">
    <p class="code mono faint enter">404</p>
    <h1 class="page-title enter" style="--i: 1">Tady nic není.</h1>
    <p class="lead enter" style="--i: 2">Stránka se přesunula, nebo nikdy neexistovala.</p>
    <a href="/" class="more back enter" style="--i: 3">
      <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M9.5 6h-7M5.5 3l-3 3 3 3"></path></svg>
      Zpět na úvod
    </a>
  </section>
</Base>

<style>
  .nf {
    padding-top: 64px;
  }

  .code {
    font-size: 0.875rem;
    margin-bottom: 12px;
  }

  .page-title {
    margin-bottom: 14px;
  }

  .more {
    margin-top: 32px;
  }
</style>
