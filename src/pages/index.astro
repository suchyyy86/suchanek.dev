---
import Base from '../layouts/Base.astro';
import CopyEmail from '../components/CopyEmail.astro';
---

<Base>
  <section class="hero">
    <h1 class="title" aria-label="Mariusz Suchanek">
      <span class="name-word" aria-hidden="true">
        {Array.from('Mariusz').map((letter, index) => (
          <span class="name-letter" style={`--letter: ${index}`}>{letter}</span>
        ))}
      </span>{' '}<span class="name-word surname" aria-hidden="true">
        {Array.from('Suchanek').map((letter, index) => (
          <span class="name-letter" style={`--letter: ${index + 7}`}>{letter}</span>
        ))}<span class="name-dot"></span>
      </span>
    </h1>

    <p class="lead enter" style="--i: 2">
      Vývojář a&nbsp;juniorní projektový manažer v&nbsp;Railsformers. Stavím weby a&nbsp;aplikace
      –&nbsp;<em class="serif">AI-first.</em>
    </p>
  </section>

  <section class="section enter" style="--i: 3">
    <h2 class="section-title">Kontakt</h2>
    <div class="contact">
      <CopyEmail />
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-top: 56px;
  }

  .title {
    margin-bottom: 24px;
  }

  .title {
    font-size: clamp(2rem, 8.5vw, 3.75rem);
  }

  .name-word {
    display: inline-block;
    white-space: nowrap;
  }

  .name-letter {
    display: inline-block;
    animation: name-reveal 800ms var(--ease) backwards;
    animation-delay: calc(80ms + var(--letter) * 38ms);
  }

  .name-dot {
    display: inline-block;
    width: 0.12em;
    height: 0.12em;
    margin-left: 0.035em;
    border-radius: 50%;
    background: var(--accent);
    animation: dot-reveal 650ms var(--spring) 720ms backwards;
  }

  @keyframes name-reveal {
    from {
      opacity: 0;
      transform: translateY(0.25em);
      filter: blur(6px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }

  @keyframes dot-reveal {
    from {
      opacity: 0;
      transform: translateY(-0.35em) scale(0.3);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .lead {
    max-width: 40ch;
  }

  .contact {
    margin-top: 16px;
  }

  @media (max-width: 560px) {
    .hero {
      padding-top: 32px;
    }
  }
</style>
