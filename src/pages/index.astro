---
import Base from '../layouts/Base.astro';
import CopyEmail from '../components/CopyEmail.astro';
---

<Base wide>
  <section class="story" aria-label="O mně">
    <div class="story-stage">
      <div class="scene scene-name">
        <h1 class="display name" aria-label="Mariusz Suchanek">
          <span class="line-mask" aria-hidden="true"><span class="line-inner">Mariusz</span></span>
          <span class="line-mask" aria-hidden="true"><span class="line-inner">Suchanek<span class="dot-anchor" data-dot-start></span></span></span>
        </h1>
        <p class="scene-note name-note">Vývojář a&nbsp;juniorní projektový manažer<br />v&nbsp;Railsformers.</p>
      </div>

      <div class="scene scene-work">
        <h2 class="display work-title">
          <span class="line-mask"><span class="line-inner">Stavím weby</span></span>
          <span class="line-mask"><span class="line-inner">a&nbsp;aplikace<span class="dot-anchor" data-dot-work aria-hidden="true"></span></span></span>
        </h2>
        <p class="work-note">AI-first.</p>
      </div>

      <div class="scene scene-contact">
        <h2 class="display contact-title">
          <span class="line-mask"><span class="line-inner">Napiš mi.</span></span>
        </h2>
        <div class="contact-pill"><CopyEmail /></div>
      </div>

      <div class="travel-dot" aria-hidden="true"></div>
      <a class="scroll-cue" href="#kontakt" aria-label="Přejít ke kontaktu">
        <span class="cue-track" aria-hidden="true"><span></span></span>
        <span>Posuň se dál</span>
      </a>
      <div class="story-progress" aria-hidden="true"><span></span></div>
    </div>
    <div id="kontakt" class="contact-destination" aria-hidden="true"></div>
  </section>
</Base>

<script>
  import '../scripts/home';
</script>

<style>
  :global(.main:has(.story)) {
    padding-top: 0;
    padding-bottom: 0;
  }

  :global(body:has(.story) .header) {
    position: absolute;
    inset: 0 0 auto;
    z-index: 10;
  }

  :global(body:has(.story) .ambient-grid) { opacity: 0.35; }
  :global(body:has(.story) .ambient-orbit) { opacity: 0.35; }

  .story { position: relative; }
  .story-stage { position: relative; }

  .scene {
    padding-block: 140px 80px;
    min-height: 65svh;
  }

  .display {
    font-size: clamp(3.5rem, 11.3vw, 9.5rem);
    font-weight: 500;
    line-height: 0.94;
    letter-spacing: -0.075em;
  }

  .line-mask {
    display: block;
    overflow: clip;
    padding-block: 0.12em;
    margin-block: -0.12em;
  }

  .line-inner {
    display: inline-block;
    padding-right: 0.035em;
  }

  .dot-anchor {
    display: inline-block;
    width: 0.085em;
    height: 0.085em;
    margin-left: 0.065em;
    border-radius: 50%;
    background: var(--accent);
  }

  .scene-note {
    margin-top: 40px;
    color: var(--text-2);
    font-size: clamp(0.9375rem, 1.35vw, 1.125rem);
    line-height: 1.65;
    letter-spacing: -0.015em;
  }

  .work-title {
    font-size: clamp(2.9rem, 9.6vw, 8rem);
  }

  .work-note {
    margin-top: 24px;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(2.5rem, 5.2vw, 4.75rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .contact-title { font-size: clamp(3.5rem, 10vw, 8.5rem); }

  .contact-pill {
    position: relative;
    z-index: 2;
    width: fit-content;
    margin-top: 48px;
  }

  .contact-pill :global(.copy) {
    padding: 10px 10px 10px 26px;
    gap: 16px;
    font-size: clamp(1rem, 1.8vw, 1.25rem);
  }

  .contact-pill :global(.copy-btn) { width: 38px; height: 38px; }

  .travel-dot,
  .scroll-cue,
  .story-progress { display: none; }

  .is-enhanced { height: 340svh; }

  .is-enhanced .story-stage {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 520px;
  }

  .is-enhanced .scene {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 0;
    padding-block: 104px 96px;
  }

  .is-enhanced .scene-work,
  .is-enhanced .scene-contact { opacity: 0; visibility: hidden; }

  .is-enhanced .dot-anchor { background: transparent; }

  .is-enhanced .travel-dot {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    border-radius: 999px;
    background: var(--accent);
    pointer-events: none;
    will-change: transform;
  }

  .is-enhanced .contact-pill :global(.copy) {
    border-color: transparent;
    background: transparent;
    box-shadow: none;
    color: var(--on-accent);
  }

  .is-enhanced .contact-pill :global(.copy-btn),
  .is-enhanced .contact-pill :global(.ic-check) { color: inherit; }

  .contact-pill :global(.copy-btn:hover) {
    background: color-mix(in srgb, var(--on-accent) 8%, transparent);
  }

  .is-enhanced .scroll-cue {
    position: absolute;
    bottom: 36px;
    left: 0;
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 0.75rem;
    color: var(--text-3);
  }

  .cue-track {
    position: relative;
    display: block;
    width: 1px;
    height: 32px;
    overflow: hidden;
    background: var(--line);
  }

  .cue-track span {
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: translateY(-100%);
    animation: cue-flow 2.6s var(--ease) infinite;
  }

  .is-enhanced .story-progress {
    position: absolute;
    right: 0;
    bottom: 44px;
    display: block;
    width: 80px;
    height: 1px;
    background: var(--line);
  }

  .story-progress > span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  .contact-destination { position: absolute; bottom: 100svh; }

  @keyframes cue-flow {
    0% { transform: translateY(-100%); }
    65%, 100% { transform: translateY(100%); }
  }

  @media (max-width: 600px) {
    .is-enhanced { height: 310svh; }
    .display { font-size: clamp(3.35rem, 13.5vw, 5rem); }
    .work-title { font-size: clamp(2.65rem, 10.7vw, 4rem); }
    .contact-title { font-size: clamp(3.3rem, 13vw, 5rem); }
    .scene-note { margin-top: 32px; }
    .contact-pill { margin-top: 36px; }
    .contact-pill :global(.copy) { gap: 8px; padding-left: 20px; }
    .is-enhanced .scene { padding-block: 88px 100px; }
    .is-enhanced .scroll-cue { bottom: 28px; }
    .is-enhanced .story-progress { bottom: 36px; width: 48px; }
  }

  @media (prefers-reduced-motion: reduce), (max-height: 519px) {
    .scene { min-height: auto; padding-block: 120px 40px; }
    .scene:last-of-type { padding-bottom: 100px; }
  }
</style>
