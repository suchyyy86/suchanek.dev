---
import Base from '../layouts/Base.astro';
import CopyEmail from '../components/CopyEmail.astro';
---

<Base wide>
  <section class="story" aria-label="O mně">
    <div class="story-stage">
      <div class="scene scene-name">
        <h1 class="display name" aria-label="Mariusz Suchanek">
          <span class="line-mask" aria-hidden="true"><span class="line-inner">{Array.from('Mariusz').map((letter) => <span class="name-char">{letter}</span>)}</span></span>
          <span class="line-mask" aria-hidden="true"><span class="line-inner">{Array.from('Suchanek').map((letter) => <span class="name-char">{letter}</span>)}<span class="dot-anchor" data-dot-start></span></span></span>
        </h1>
        <p class="scene-note name-note">Vývojář a&nbsp;juniorní projektový manažer<br />v&nbsp;Railsformers.</p>
      </div>

      <div class="scene scene-work">
        <h2 class="display work-title">
          <span class="line-mask"><span class="line-inner">Stavím weby</span></span>
          <span class="line-mask"><span class="line-inner">a&nbsp;aplikace<span class="dot-anchor" data-dot-work aria-hidden="true"></span></span></span>
        </h2>
        <p class="work-note">
          AI-first.
          <svg class="work-underline" viewBox="0 0 150 20" preserveAspectRatio="none" aria-hidden="true">
            <defs>
              <mask id="work-underline-reveal" maskUnits="userSpaceOnUse" x="-5" y="-5" width="160" height="30">
                <path class="work-underline-ink" d="M 3 7 C 30 4, 75 3, 104 4 C 111 4.5, 76 11, 35 14 C 18 15, 15 12.5, 31 12 C 70 10.5, 111 13, 147 8" pathLength="1" />
              </mask>
            </defs>
            <path d="M 3 7 C 30 4, 75 3, 104 4 C 111 4.5, 76 11, 35 14 C 18 15, 15 12.5, 31 12 C 70 10.5, 111 13, 147 8" mask="url(#work-underline-reveal)" />
          </svg>
        </p>
      </div>

      <div class="scene scene-contact">
        <h2 class="display contact-title">
          <span class="line-mask"><span class="line-inner">Napiš mi.</span></span>
        </h2>
        <div class="contact-pill"><CopyEmail /></div>
      </div>

      <div class="travel-dot" aria-hidden="true"></div>
      <a class="scroll-cue" href="#kontakt" aria-label="Přejít ke kontaktu">
        <span class="cue-track" aria-hidden="true"><span></span></span>
        <span class="cue-label" aria-hidden="true">
          <span data-scroll-label>Zvědavý?</span>
          <span data-scroll-label>Zvědavost tě posune dál.</span>
          <span data-scroll-label>Kontakt</span>
        </span>
      </a>
    </div>
    <div id="kontakt" class="contact-destination" aria-hidden="true"></div>
  </section>
</Base>

<script>
  import '../scripts/home';
</script>

<style>
  :global(.main:has(.story)) {
    padding-top: 0;
    padding-bottom: 0;
  }

  :global(body:has(.story) .header) {
    position: absolute;
    inset: 0 0 auto;
    z-index: 10;
  }

  :global(body:has(.story) .ambient-grid) { opacity: 0.35; }
  :global(body:has(.story) .ambient-orbit) { opacity: 0.35; }

  :global(body:has(.story.is-enhanced) .footer) {
    position: relative;
    z-index: 3;
  }

  .story { position: relative; }
  .story-stage { position: relative; }

  .scene {
    padding-block: 140px 80px;
    min-height: 65svh;
  }

  .display {
    font-size: clamp(3.5rem, 11.3vw, 9.5rem);
    font-weight: 500;
    line-height: 0.94;
    letter-spacing: -0.075em;
  }

  .line-mask {
    display: block;
    overflow: clip;
    padding-block: 0.12em;
    margin-block: -0.12em;
  }

  .line-inner {
    display: inline-block;
    padding-right: 0.035em;
  }

  .dot-anchor {
    display: inline-block;
    width: 0.085em;
    height: 0.085em;
    margin-left: 0.065em;
    border-radius: 50%;
    background: var(--accent);
  }

  .name-char { display: inline-block; }

  .scene-note {
    margin-top: 40px;
    color: var(--text-2);
    font-size: clamp(0.9375rem, 1.35vw, 1.125rem);
    line-height: 1.65;
    letter-spacing: -0.015em;
  }

  .work-title {
    font-size: clamp(2.9rem, 9.6vw, 8rem);
  }

  .work-note {
    position: relative;
    width: fit-content;
    margin-top: 24px;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(2.5rem, 5.2vw, 4.75rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .work-underline {
    position: absolute;
    left: -0.035em;
    top: calc(100% + 4px);
    width: 125%;
    height: 0.28em;
    overflow: visible;
    pointer-events: none;
  }

  .work-underline > path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.7px;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .work-underline-ink {
    fill: none;
    stroke: white;
    stroke-width: 8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .contact-title { font-size: clamp(3.5rem, 10vw, 8.5rem); }

  .contact-pill {
    position: relative;
    z-index: 2;
    width: fit-content;
    margin-top: 48px;
  }

  .travel-dot,
  .scroll-cue { display: none; }

  .is-enhanced { height: 435svh; }

  .is-enhanced .story-stage {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 520px;
  }

  .is-enhanced .scene {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 0;
    padding-block: 104px 96px;
  }

  .is-enhanced .scene-work,
  .is-enhanced .scene-contact { opacity: 0; visibility: hidden; }

  .is-enhanced .dot-anchor { background: transparent; }

  .is-enhanced .travel-dot {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    border-radius: 999px;
    background: var(--accent);
    border: 1px solid transparent;
    pointer-events: none;
    will-change: transform;
  }

  .is-enhanced .contact-pill :global(.copy) {
    border-color: transparent;
    background: transparent;
    box-shadow: none;
    color: var(--text);
  }

  .is-enhanced .contact-pill :global(.copy:hover) {
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .is-enhanced .contact-pill :global(.copy:active) {
    background: color-mix(in srgb, var(--accent) 14%, transparent);
  }

  .is-enhanced .scroll-cue {
    position: absolute;
    bottom: 36px;
    left: 0;
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 0.75rem;
    color: var(--text-3);
  }

  .cue-track {
    position: relative;
    display: block;
    width: 1px;
    height: 32px;
    overflow: hidden;
    background: var(--line);
  }

  .cue-label {
    display: grid;
    overflow: clip;
    perspective: 500px;
    line-height: 1.6;
  }

  .cue-label > span {
    grid-area: 1 / 1;
    white-space: nowrap;
    transform-origin: 50% 50%;
    backface-visibility: hidden;
  }

  .cue-label > span:not(:first-child) { opacity: 0; }

  .cue-track span {
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: top;
  }

  .contact-destination { position: absolute; bottom: 100svh; }

  @media (max-width: 600px) {
    .is-enhanced { height: 400svh; }
    .display { font-size: clamp(3.35rem, 13.5vw, 5rem); }
    .work-title { font-size: clamp(2.65rem, 10.7vw, 4rem); }
    .contact-title { font-size: clamp(3.3rem, 13vw, 5rem); }
    .scene-note { margin-top: 32px; }
    .contact-pill { margin-top: 36px; }
    .is-enhanced .scene { padding-block: 88px 100px; }
    .is-enhanced .scroll-cue { bottom: 28px; }
  }

  @media (prefers-reduced-motion: reduce), (max-height: 519px) {
    .scene { min-height: auto; padding-block: 120px 40px; }
    .scene:last-of-type { padding-bottom: 100px; }
  }
</style>
