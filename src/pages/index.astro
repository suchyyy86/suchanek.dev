---
import Base from '../layouts/Base.astro';
import ProjectList from '../components/ProjectList.astro';
import CopyEmail from '../components/CopyEmail.astro';
import { featuredProjects } from '../data/projects';
---

<Base>
  <section class="hero">
    <h1 class="title">
      <span class="word enter">Mariusz</span>{' '}<span class="word enter" style="--i: 1"
        >Suchanek<span class="accent">.</span></span
      >
    </h1>

    <p class="lead enter" style="--i: 2">
      Vývojář a&nbsp;juniorní projektový manažer v&nbsp;Railsformers. Stavím weby a&nbsp;aplikace
      –&nbsp;<em class="serif">AI-first.</em>
    </p>
  </section>

  <section class="section enter" style="--i: 3">
    <div class="section-head">
      <h2 class="section-title">Projekty</h2>
      <a href="/projekty" class="more">
        Všechny
        <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 6h7M6.5 3l3 3-3 3"></path></svg>
      </a>
    </div>
    <ProjectList projects={featuredProjects} />
  </section>

  <section class="section scroll-in">
    <h2 class="section-title">Kontakt</h2>
    <div class="contact">
      <CopyEmail />
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-top: 56px;
  }

  .title {
    margin-bottom: 24px;
  }

  .word {
    display: inline-block;
  }

  .lead {
    max-width: 40ch;
  }

  .contact {
    margin-top: 16px;
  }

  @media (max-width: 560px) {
    .hero {
      padding-top: 32px;
    }
  }
</style>
