---
import Base from '../layouts/Base.astro';
import CopyEmail from '../components/CopyEmail.astro';
---

<Base>
  <section class="hero">
    <h1 class="title">
      <span class="word enter">Mariusz</span>{' '}<span class="word enter" style="--i: 1"
        >Suchanek<span class="accent">.</span></span
      >
    </h1>

    <p class="lead enter" style="--i: 2">
      Vývojář a&nbsp;juniorní projektový manažer v&nbsp;Railsformers. Stavím weby a&nbsp;aplikace
      –&nbsp;<em class="serif">AI-first.</em>
    </p>
  </section>

  <section class="section enter" style="--i: 3">
    <h2 class="section-title">Kontakt</h2>
    <div class="contact">
      <CopyEmail />
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-top: 56px;
  }

  .title {
    margin-bottom: 24px;
  }

  .word {
    display: inline-block;
  }

  .lead {
    max-width: 40ch;
  }

  .contact {
    margin-top: 16px;
  }

  @media (max-width: 560px) {
    .hero {
      padding-top: 32px;
    }
  }
</style>
