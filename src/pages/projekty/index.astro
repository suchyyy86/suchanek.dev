---
import Base from '../../layouts/Base.astro';
import ProjectList from '../../components/ProjectList.astro';
import { publishedProjects } from '../../data/projects';
---

<Base title="Projekty" description="Projekty Mariusze Suchanka – práce, škola i vlastní experimenty.">
  <header class="page-head">
    <h1 class="page-title enter">Projekty</h1>
  </header>

  <div class="list enter" style="--i: 1">
    <ProjectList projects={publishedProjects} />
  </div>
</Base>

<style>
  .page-head {
    padding-top: 24px;
  }

  .list {
    margin-top: 48px;
  }
</style>
