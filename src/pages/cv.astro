---
import Base from '../layouts/Base.astro';
import { profile, experience, education, skills, languages, certificates } from '../data/cv';
import { site } from '../data/site';
import { cz } from '../utils/cz';
---

<Base title="CV" description={profile}>
  <header class="page-head">
    <h1 class="page-title enter">CV</h1>
    <p class="lead enter" style="--i: 1">{cz(site.role)}.</p>
    <ul class="facts enter" style="--i: 2">
      <li>{site.location}</li>
      <li><a class="link" href={`mailto:${site.email}`}>{site.email}</a></li>
      <li><a class="link" href={site.linkedin} target="_blank" rel="me noopener">LinkedIn</a></li>
    </ul>
  </header>

  <section class="section enter" style="--i: 3">
    <h2 class="section-title">Pracovní zkušenosti</h2>
    <ol class="timeline">
      {
        experience.map((e) => (
          <li class="t-item scroll-in">
            <span class="t-when">{e.period}</span>
            <div>
              <h3 class="t-title">
                {e.href ? (
                  <a class="link" href={e.href} target="_blank" rel="noopener">
                    {e.company}
                  </a>
                ) : (
                  e.company
                )}
              </h3>
              <p class="t-sub">{e.role}</p>
              <ul class="t-points">
                {e.points.map((p) => (
                  <li>{cz(p)}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section enter" style="--i: 4">
    <h2 class="section-title">Vzdělání</h2>
    <ol class="timeline">
      {
        education.map((e) => (
          <li class="t-item scroll-in">
            <span class="t-when">{e.period}</span>
            <div>
              <h3 class="t-title">{e.school}</h3>
              <p class="t-sub">{e.field}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section scroll-in">
    <h2 class="section-title">Dovednosti</h2>
    <ul class="chips skills">
      {skills.map((s) => <li>{s}</li>)}
    </ul>
  </section>

  <div class="cols">
    <section class="section scroll-in">
      <h2 class="section-title">Jazyky</h2>
      <ul class="kv">
        {
          languages.map((l) => (
            <li>
              <span>{l.name}</span>
              <span class="faint">{l.level}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section scroll-in">
      <h2 class="section-title">Certifikace</h2>
      <ul class="kv">
        {certificates.map((c) => <li><span>{c}</span></li>)}
      </ul>
    </section>
  </div>
</Base>

<style>
  .page-head {
    padding-top: 24px;
  }

  .page-title {
    margin-bottom: 16px;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
    color: var(--text-2);
  }

  .timeline {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
  }

  .t-item {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 4px 24px;
    padding: 22px 0;
    border-top: 1px solid var(--line);
  }

  .t-item:first-child {
    border-top: 0;
    padding-top: 10px;
  }

  .t-when {
    padding-top: 3px;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }

  .t-title {
    font-size: 1rem;
    letter-spacing: -0.01em;
  }

  .t-sub {
    margin-top: 2px;
    font-size: 0.9375rem;
    color: var(--text-2);
  }

  .t-points {
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
    color: var(--text-2);
  }

  .t-points li {
    position: relative;
    margin-top: 6px;
    padding-left: 18px;
  }

  .t-points li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.78em;
    width: 7px;
    height: 1px;
    background: var(--text-3);
  }

  .skills {
    margin-top: 16px;
  }

  .cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 40px;
  }

  .kv {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
    font-size: 0.9375rem;
  }

  .kv li {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 0;
    border-top: 1px solid var(--line);
  }

  .kv li:first-child {
    border-top: 0;
  }

  @media (max-width: 560px) {
    .t-item {
      grid-template-columns: minmax(0, 1fr);
    }

    .cols {
      grid-template-columns: 1fr;
    }
  }
</style>
