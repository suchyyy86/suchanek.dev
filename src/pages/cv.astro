---
import Base from '../layouts/Base.astro';

const LINKEDIN = 'https://www.linkedin.com/in/mariusz-suchanek-9263a12a2/';

const experience = [
  {
    company: 'Railsformers',
    href: 'https://railsformers.com',
    role: 'Vývojář aplikací / juniorní projektový manažer',
    period: '07/2025 – současnost',
    points: [
      'Frontendový vývoj 3D aplikace digitálního dvojčete budovy.',
      'Vizualizace provozních dat a údajů ze senzorů.',
      'Vývoj webů ve WordPressu s využitím AI nástrojů a MCP.',
      'Vedení menších projektů, koordinace vývoje a komunikace s klienty.',
    ],
  },
  {
    company: 'K2 atmitec',
    role: 'Maturitní projekt',
    period: '09/2024 – 03/2025',
    points: ['Vývoj JavaScript knihovny pro vyhledávání a úpravu překladů v XML souborech.'],
  },
  {
    company: 'Třinecké železárny',
    role: 'Odborná praxe v IT oddělení',
    period: '05/2024',
    points: ['Spolupráce na frontendové a backendové části nového informačního systému.'],
  },
];

const education = [
  {
    school: 'VŠB – Technická univerzita Ostrava',
    field: 'Ekonomická fakulta · Ekonomie',
    period: '2025 – současnost',
  },
  {
    school: 'Střední průmyslová škola Karviná',
    field: 'Informační technologie · maturita s vyznamenáním',
    period: '2021 – 2025',
  },
];

const skills = [
  'JavaScript, HTML, CSS',
  'Vývoj webových aplikací',
  'Frontend a 3D aplikace',
  'WordPress',
  'AI-driven vývoj (MCP)',
  'Vedení menších projektů',
  'Komunikace s klienty',
];

const languages = [
  { name: 'Čeština', level: 'rodilý mluvčí' },
  { name: 'Polština', level: 'rodilý mluvčí' },
  { name: 'Angličtina', level: 'C1 (CAE)' },
];

const certificates = ['Cambridge English: Advanced (CAE)', 'Řidičský průkaz skupiny B'];
---

<Base title="CV" description="Životopis Mariusze Suchanka – vývojář webových aplikací a juniorní projektový manažer.">
  <p class="label">Životopis</p>
  <h1>CV</h1>
  <p class="role">Vývojář webových aplikací · Juniorní projektový manažer</p>
  <p class="muted">
    Vývojář s praxí na komplexní 3D aplikaci, WordPress webech a vedení menších projektů. Propojuji
    technický vývoj, AI nástroje a komunikaci s klienty. Studuji ekonomii na VŠB-TUO.
  </p>

  <ul class="contact">
    <li>Český Těšín / Ostravsko</li>
    <li><a href="mailto:ahoj@suchanek.dev">ahoj@suchanek.dev</a></li>
    <li><a href={LINKEDIN} rel="me noopener" target="_blank">LinkedIn ↗</a></li>
  </ul>

  <h2>Pracovní zkušenosti</h2>
  {
    experience.map((e) => (
      <article class="item">
        <div class="item-head">
          <h3>{e.href ? <a href={e.href}>{e.company}</a> : e.company}</h3>
          <span class="label">{e.period}</span>
        </div>
        <p class="muted sub">{e.role}</p>
        <ul>
          {e.points.map((p) => (
            <li>{p}</li>
          ))}
        </ul>
      </article>
    ))
  }

  <h2>Vzdělání</h2>
  {
    education.map((e) => (
      <article class="item">
        <div class="item-head">
          <h3>{e.school}</h3>
          <span class="label">{e.period}</span>
        </div>
        <p class="muted sub">{e.field}</p>
      </article>
    ))
  }

  <div class="cols">
    <section>
      <h2>Dovednosti</h2>
      <ul class="tags">
        {skills.map((s) => <li>{s}</li>)}
      </ul>
    </section>
    <section>
      <h2>Jazyky</h2>
      <ul class="plain">
        {languages.map((l) => <li><strong>{l.name}</strong> <span class="muted">· {l.level}</span></li>)}
      </ul>
      <h2>Certifikace</h2>
      <ul class="plain">
        {certificates.map((c) => <li>{c}</li>)}
      </ul>
    </section>
  </div>
</Base>

<style>
  .role {
    font-weight: 600;
    margin-bottom: 0.6em;
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.95rem;
  }
  .item {
    padding: 4px 0 12px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 16px;
  }
  .item:last-of-type {
    border-bottom: 0;
  }
  .item-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 16px;
  }
  .item h3 {
    margin: 0;
  }
  .sub {
    margin: 0.15em 0 0;
    font-size: 0.95rem;
  }
  .item ul {
    padding-left: 1.1em;
    margin: 0.5em 0 0;
  }
  .item li {
    margin-bottom: 0.3em;
  }
  .cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 40px;
  }
  .plain {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .plain li {
    margin-bottom: 0.3em;
  }
  @media (max-width: 600px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
</style>
