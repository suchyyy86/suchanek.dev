---
import Base from '../layouts/Base.astro';
import {
  name,
  headline,
  profile,
  experience,
  education,
  contact,
  skills,
  languages,
  certificates,
} from '../data/cv';
import { site } from '../data/site';
import { cz } from '../utils/cz';
---

<Base title="CV" description={profile}>
  <header class="page-head">
    <h1 class="page-title enter">{name}</h1>
    <p class="headline enter" style="--i: 1">
      {headline[0]} <span class="sep">|</span> {headline[1]}
    </p>
  </header>

  <section class="section enter" style="--i: 2">
    <h2 class="section-title">Profil</h2>
    <p class="body">{cz(profile)}</p>
  </section>

  <section class="section enter" style="--i: 3">
    <h2 class="section-title">Pracovní zkušenosti</h2>
    {
      experience.map((e) => (
        <article class="entry scroll-in">
          <h3 class="entry-title">{e.company}</h3>
          <p class="entry-sub">{e.role}</p>
          <p class="entry-date">{e.period}</p>
          <ul class="entry-points">
            {e.points.map((p) => (
              <li>{cz(p)}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </section>

  <section class="section scroll-in">
    <h2 class="section-title">Vzdělání</h2>
    {
      education.map((e) => (
        <article class="entry">
          <h3 class="entry-title">{e.school}</h3>
          <p class="entry-sub">{e.detail}</p>
        </article>
      ))
    }
  </section>

  <div class="side">
    <section class="scroll-in">
      <h2 class="section-title">Kontakt</h2>
      <ul class="plain">
        <li>{contact.location}</li>
        <li><a class="link" href={`mailto:${site.email}`}>{site.email}</a></li>
        <li>
          <a class="link" href={site.linkedin} target="_blank" rel="me noopener">{contact.linkedinLabel}</a>
        </li>
      </ul>
    </section>

    <section class="scroll-in">
      <h2 class="section-title">Dovednosti</h2>
      <ul class="plain">
        {skills.map((s) => <li>{s}</li>)}
      </ul>
    </section>

    <section class="scroll-in">
      <h2 class="section-title">Jazyky</h2>
      <ul class="plain">
        {languages.map((l) => <li>{l}</li>)}
      </ul>
    </section>

    <section class="scroll-in">
      <h2 class="section-title">Certifikace</h2>
      <ul class="plain">
        {certificates.map((c) => <li>{c}</li>)}
      </ul>
    </section>
  </div>
</Base>

<style>
  .page-head {
    padding-top: 24px;
  }

  .page-title {
    margin-bottom: 12px;
  }

  .headline {
    font-size: 1.0625rem;
    color: var(--text-2);
  }

  .sep {
    margin: 0 0.2em;
    color: var(--text-3);
  }

  .section {
    margin-top: 72px;
  }

  .body {
    margin-top: 14px;
    max-width: 60ch;
    color: var(--text-2);
  }

  .entry {
    padding: 20px 0;
    border-top: 1px solid var(--line);
  }

  .entry:first-of-type {
    border-top: 0;
    padding-top: 12px;
  }

  .entry-title {
    font-size: 1rem;
    letter-spacing: -0.01em;
  }

  .entry-sub {
    margin-top: 2px;
    font-size: 0.9375rem;
    color: var(--text-2);
  }

  .entry-date {
    margin-top: 2px;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }

  .entry-points {
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
    color: var(--text-2);
  }

  .entry-points li {
    position: relative;
    margin-top: 6px;
    padding-left: 16px;
  }

  .entry-points li::before {
    content: '';
    position: absolute;
    left: 3px;
    top: 0.7em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--text-3);
  }

  .side {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px 40px;
    margin-top: 72px;
  }

  .plain {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    font-size: 0.9375rem;
  }

  .plain li {
    padding: 9px 0;
    border-top: 1px solid var(--line);
    overflow-wrap: anywhere;
  }

  .plain li:first-child {
    border-top: 0;
    padding-top: 4px;
  }

  @media (max-width: 560px) {
    .side {
      grid-template-columns: 1fr;
      gap: 56px;
    }
  }
</style>
