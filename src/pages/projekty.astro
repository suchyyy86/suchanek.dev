---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { publishedProjects } from '../data/projects';
---

<Base title="Projekty" description="Projekty Mariusze Suchanka – práce, klienti a vlastní experimenty.">
  <p class="label">Portfolio</p>
  <h1>Projekty</h1>
  <p class="muted">Postupně se plní. Pracovní věci, zakázky a vlastní experimenty z labu.</p>

  <div class="grid" style="margin-top: 32px">
    {publishedProjects.map((p) => <ProjectCard project={p} />)}
  </div>
</Base>
