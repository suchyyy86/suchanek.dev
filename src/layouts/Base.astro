---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
}

const {
  title,
  description = `${site.name} – ${site.role.toLowerCase()}. AI-first vývoj, weby a automatizace.`,
  wide = false,
} = Astro.props;

const fullTitle = title ? `${title} · ${site.name}` : `${site.name} – vývojář`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(Astro.url.pathname, Astro.site);

// Projekty jsou zatím skryté (src/pages/_projekty). Až se vrátí, přidej sem { href: '/projekty', label: 'Projekty' }.
const nav = [
  { href: '/', label: 'Úvod' },
  { href: '/cv', label: 'CV' },
];

const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta name="theme-color" content="#fbfbfa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
  </head>
  <body>
    <div class="ambient" aria-hidden="true" transition:persist="ambient">
      <div class="ambient-grid"></div>
      <div class="ambient-glow"></div>
      <div class="ambient-orbit"></div>
    </div>
    <header class="header" transition:name="site-header">
      <div class:list={['wrap', 'header-inner', { wide }]}>
        <a href="/" class="logo" aria-label="suchanek.dev – úvod">suchanek<span class="logo-dot">.</span>dev</a>
        <nav class="nav" aria-label="Hlavní navigace">
          {
            nav.map((item) => {
              const active = isActive(item.href);
              return (
                <a href={item.href} class="nav-link" aria-current={active ? 'page' : undefined}>
                  {active && <span class="nav-pill" transition:name="nav-pill" />}
                  {item.label}
                </a>
              );
            })
          }
        </nav>
      </div>
    </header>

    <main class:list={['wrap', 'main', { wide }]}>
      <slot />
    </main>

    <footer class="footer">
      <div class:list={['wrap', 'footer-inner', { wide }]}>
        <span>© {new Date().getFullYear()} {site.name}</span>
        <span class="footer-links">
          <a class="link" href={site.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
          <a class="link" href={site.github} rel="me noopener" target="_blank">GitHub</a>
        </span>
      </div>
    </footer>

    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>

<style>
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 88px;
    padding-top: 12px;
  }

  .logo {
    font-family: var(--mono);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .logo-dot {
    display: inline-block;
    color: var(--accent);
    transition: transform 0.5s var(--spring);
  }

  .logo:hover .logo-dot {
    transform: translateY(-4px);
  }

  .nav {
    display: flex;
    gap: 2px;
    margin-right: -12px;
  }

  .nav-link {
    position: relative;
    isolation: isolate;
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 0.875rem;
    color: var(--text-3);
    transition: color 0.25s;
  }

  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: var(--text);
  }

  .nav-pill {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 999px;
    background: color-mix(in srgb, var(--text) 7%, transparent);
  }

  .main {
    flex: 1 0 auto;
    padding-top: 56px;
    padding-bottom: 128px;
  }

  .footer {
    font-size: 0.8125rem;
    color: var(--text-3);
  }

  .footer-inner {
    position: relative;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px 24px;
    padding-top: 28px;
    padding-bottom: 40px;
  }

  .footer-inner::before {
    content: '';
    position: absolute;
    top: 0;
    left: var(--gutter);
    right: var(--gutter);
    height: 1px;
    background: var(--line);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 18px;
  }

  .footer-links a {
    color: var(--text-2);
  }

  @media (max-width: 560px) {
    .header-inner {
      height: 72px;
    }

    .main {
      padding-top: 32px;
      padding-bottom: 96px;
    }
  }
</style>
