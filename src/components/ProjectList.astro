---
import type { Project } from '../data/projects';
import { cz } from '../utils/cz';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<ul class="rows">
  {
    projects.map((p) => {
      const external = p.href?.startsWith('http');
      const Tag = p.href ? 'a' : 'div';
      return (
        <li class="scroll-in">
          <Tag
            class="row"
            href={p.href}
            target={external ? '_blank' : undefined}
            rel={external ? 'noopener' : undefined}
          >
            <span class="row-main">
              <span class="row-title">
                {p.title}
                {p.href && (
                  <svg class="row-arrow" viewBox="0 0 12 12" aria-hidden="true">
                    {external ? <path d="M3.5 8.5l5-5M4.5 3.5h4v4" /> : <path d="M2.5 6h7M6.5 3l3 3-3 3" />}
                  </svg>
                )}
              </span>
              <span class="row-desc">{cz(p.description)}</span>
            </span>
            <span class="row-meta">{p.year}</span>
          </Tag>
        </li>
      );
    })
  }
</ul>
