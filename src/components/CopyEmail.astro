---
import { site } from '../data/site';

interface Props {
  email?: string;
}

const { email = site.email } = Astro.props;
---

<button class="copy" type="button" data-copy={email} data-copy-box aria-label={`Zkopírovat e-mail ${email}`}>
  <span class="copy-value" data-copy-value>{email}</span>
  <span class="copy-feedback" data-copy-toast role="status" aria-live="polite" aria-atomic="true"></span>
</button>

<style>
  .copy {
    position: relative;
    display: inline-grid;
    place-items: center;
    min-height: 56px;
    padding: 15px 28px;
    border: 1.5px solid var(--accent);
    border-radius: 8px;
    background: transparent;
    color: var(--text);
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.4;
    white-space: nowrap;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 250ms var(--ease), color 250ms var(--ease);
  }

  .copy:hover {
    background: color-mix(in srgb, var(--accent) 7%, transparent);
  }

  .copy.copied { color: var(--accent); }

  .copy:active {
    background: color-mix(in srgb, var(--accent) 14%, var(--surface));
  }

  .copy-value,
  .copy-feedback {
    grid-area: 1 / 1;
    transition: opacity 200ms var(--ease), transform 300ms var(--ease);
  }

  .copy-feedback {
    opacity: 0;
    transform: translateY(5px);
  }

  .copied .copy-value {
    opacity: 0;
    transform: translateY(-5px);
  }

  .copied .copy-feedback {
    opacity: 1;
    transform: none;
  }

  .copy-failed .copy-value { user-select: all; }

  .copy-failed .copy-feedback {
    position: absolute;
    top: calc(100% + 10px);
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--text-2);
    opacity: 1;
    transform: none;
  }
</style>
